# LLM provider: `openai` or `claude`.
LLM_PROVIDER=openai

# LLM auth mode: `api-key` uses the provider API key directly; `setup-token` routes through CLIProxy.
LLM_MODE=setup-token

# Optional model override. Leave blank to use the repo default:
# `gpt-4.1-mini` for OpenAI, `claude-sonnet-4-5` for Claude.
LLM_MODEL=

# OpenAI API key. Required when `LLM_PROVIDER=openai` and `LLM_MODE=api-key`.
OPENAI_API_KEY=

# Claude API key. Required when `LLM_PROVIDER=claude` and `LLM_MODE=api-key`.
CLAUDE_API_KEY=

# OpenAI-compatible proxy base URL. In `setup-token` mode the app connects here.
LLM_PROXY_URL=http://localhost:8317

# Optional Semantic Scholar API key for higher-rate literature retrieval.
SEMANTIC_SCHOLAR_API_KEY=

# Optional contact email used by OpenAlex requests to improve reliability.
OPENALEX_EMAIL=

# Optional Tavily API key for web-assisted discovery and verification.
TAVILY_API_KEY=

# Session storage root, relative to the repo root by default.
SESSION_DATA_ROOT=data/sessions

# Max characters sent into the parser for a single document.
MAX_PARSE_CHARS=120000

# Docling-backed PDF parsing controls.
DOCLING_ENABLED=1
# Set to 0 to parse text-native PDFs without initializing OCR artifacts.
DOCLING_OCR_ENABLED=1
DOCLING_ARTIFACTS_PATH=.cache/docling
DOCLING_MAX_PAGES=80
DOCLING_MAX_FILE_SIZE_MB=50
DOCLING_OMP_THREADS=4
DOCLING_BATCH_SIZE=1
# Docling accelerator device: auto, cpu, cuda, cuda:0, mps, or xpu.
DOCLING_DEVICE=auto

# Test-only safety switch. Keep `0` for normal runs; tests set this to `1`.
PAPERREADER_TEST_MODE=0
